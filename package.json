{
  "name": "wencai_agent",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test:deployment": "node --test tests/demo-sms.test.mjs",
    "dev": "node scripts/start-local.mjs",
    "dev:web": "vite dev --port 3000",
    "worker": "node --import=tsx scripts/worker.ts",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:reset": "mkdir -p data && rm -f data/bank.db && drizzle-kit push --force && tsx src/server/db/seed.ts",
    "bot:lark": "tsx scripts/lark-bot.ts",
    "mcp": "tsx scripts/mcp-server.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.63",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@ai-sdk/react": "^4.0.140",
    "@base-ui/react": "^1.9.0",
    "@chat-adapter/state-memory": "^4.41.1",
    "@hono/node-server": "^2.1.4",
    "@json-render/core": "^0.21.0",
    "@json-render/react": "^0.21.0",
    "@larksuite/vercel-chat-adapter": "^0.3.0",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@streamdown/cjk": "^1.0.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-devtools": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.61",
    "ai": "^7.0.137",
    "better-auth": "1.7.7",
    "chat": "^4.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.13.13",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.577.0",
    "motion": "^14.1.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.2.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "streamdown": "^2.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}

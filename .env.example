# 主模型：DeepSeek V4.1 Flash（官方模型 ID）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 降级模型（OpenAI 兼容接口，如 Qwen3）
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=qwen3-32b

# Qwen3Guard（vLLM 部署）；不配置时仅使用启发式审核
GUARD_BASE_URL=
GUARD_API_KEY=
GUARD_MODEL=Qwen/Qwen3Guard-Gen-4B

# 待确认动作 HMAC 密钥（本地至少16位，生产至少32位随机值）；同时用作 better-auth 的签名密钥
CONFIRM_SECRET=
CONFIRM_TTL_SECONDS=300
DATABASE_URL=file:./data/bank.db
# Passkey 的 RP ID / Origin 取自主机名，部署到域名下必须改成真实地址
PUBLIC_BASE_URL=http://localhost:3000
# 仅用于种子演示账号，不再作为未设置密码账号的验证兜底
DEMO_TX_PASSWORD=123456
# 比赛演示显式开启模拟指纹/人脸（包括使用生产构建的演示部署）。不会采集或核验生物特征。
# 正式业务应关闭并接入真实验证；未设置时开发默认开启，NODE_ENV=production 默认关闭。
# 异常转账要求付款卡密码 + 指纹/人脸，不能以 Passkey 或短信替代第二步。
AUTH_DEMO_MODE=true
# 短信发送适配器：POST JSON {phoneNumber,code,expiresInSeconds,purpose}，成功返回2xx；红色验证码不使用日志模拟
SMS_DELIVERY_URL=
SMS_DELIVERY_TOKEN=

# 演示登录手机号（验证码打印在服务端日志，不接短信网关）
# 13800000000 → 张小明（u_demo）  13800000001 → 李小萌（u_other）

# 飞书机器人
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BOT_USERNAME=wencai

# 免认证仅限本地开发，非本地或生产启用后台必须配置至少24位 ADMIN_TOKEN
# ADMIN_ENABLED=false
# ADMIN_TOKEN=replace-with-a-long-random-secret
